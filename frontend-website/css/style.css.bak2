/* ============================================================
   H.O 和悦酒店官网  ·  设计风格参考 YANG 设计集团官网
   高端 / 大图 / 极简 / 中英双语 / 酒红点缀
   ============================================================ */
:root{
  --red:#a4143c;          /* 品牌酒红 */
  --red-dark:#7d0e2d;
  --ink:#1a1715;          /* 深墨 */
  --wood:#2b2118;         /* 木色深底 */
  --gold:#b08d57;         /* 香槟金 */
  --cream:#faf8f5;        /* 米白 */
  --paper:#ffffff;
  --muted:#8a8378;
  --line:#e8e4dc;
  --serif:"Songti SC","STSong","Noto Serif SC","SimSun",serif;
  --sans:"PingFang SC","Microsoft YaHei","Helvetica Neue",Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--sans);color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased;line-height:1.7}
img{display:block;width:100%;object-fit:cover}
a{text-decoration:none;color:inherit}
button,input,select{font-family:inherit;font-size:inherit}
button{cursor:pointer}
.container{width:min(1240px,90%);margin:0 auto}
.section{padding:120px 0}
.loading{padding:60px 0;text-align:center;color:var(--muted);letter-spacing:.1em}

/* ---------- 通用组件 ---------- */
.sec-eyebrow{font-size:12px;letter-spacing:.32em;color:var(--red);text-transform:uppercase;display:flex;align-items:center;gap:14px;font-weight:600}
.sec-eyebrow .line{display:inline-block;width:34px;height:1px;background:var(--red)}
.sec-eyebrow.center{justify-content:center}
.sec-title{font-family:var(--serif);font-size:clamp(32px,4vw,52px);font-weight:600;line-height:1.35;letter-spacing:.06em;margin:20px 0 8px}
.sec-title.center{text-align:center}
.sec-en{font-family:Georgia,serif;font-style:italic;font-size:17px;color:var(--muted);letter-spacing:.02em;margin-bottom:36px}
.sec-en.center{text-align:center}
.para{font-size:15px;line-height:2;color:#5f5a53;margin-bottom:18px}
.btn{display:inline-flex;align-items:center;gap:12px;padding:13px 30px;font-size:13px;letter-spacing:.14em;border:1px solid transparent;transition:.3s;white-space:nowrap}
.btn-outline{border-color:var(--ink);color:var(--ink);background:transparent}
.btn-outline:hover{background:var(--ink);color:#fff}
.btn-dark{background:var(--ink);color:#fff}
.btn-dark:hover{background:var(--red)}
.btn-light{background:#fff;color:var(--ink)}
.btn-light:hover{background:var(--red);color:#fff}
.btn-text{color:inherit;background:none;padding-left:0;padding-right:0}
.btn-text:hover{color:var(--red)}
.btn.block{display:flex;justify-content:center;width:100%}
.link-btn{border:none;background:none;color:inherit;font-size:13px;padding:0;transition:.2s}
.link-btn:hover{color:var(--red)}

/* ---------- 顶部导航 ---------- */
.site-header{position:fixed;top:0;left:0;width:100%;z-index:100;padding:22px 0;transition:.4s;color:#fff}
.site-header.scrolled{background:rgba(255,255,255,.97);box-shadow:0 2px 20px rgba(0,0,0,.06);padding:12px 0;color:var(--ink);backdrop-filter:blur(10px)}
.hd-inner{width:min(1400px,94%);margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:12px;flex-shrink:0}
.brand-mark{font-family:Georgia,serif;font-size:30px;font-weight:700;letter-spacing:-.04em;line-height:1;color:var(--red)}
.brand-mark span{color:inherit}
.brand-text{display:flex;flex-direction:column;line-height:1.2;border-left:1px solid currentColor;padding-left:12px;opacity:.95}
.brand-text b{font-family:var(--serif);font-size:14px;letter-spacing:.28em}
.brand-text i{font-family:Georgia,serif;font-size:8px;letter-spacing:.24em;font-style:normal;opacity:.7;margin-top:3px}
.main-nav{display:flex;gap:34px;margin-left:auto}
.main-nav a{font-size:14px;letter-spacing:.16em;position:relative;padding:6px 0;white-space:nowrap}
.main-nav a::after{content:"";position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--red);transition:.3s}
.main-nav a:hover::after,.main-nav a.active::after{width:100%}
.main-nav a:hover,.main-nav a.active{color:var(--red)}
.hd-actions{display:flex;align-items:center;gap:16px;flex-shrink:0}
.icon-btn{border:none;background:none;color:inherit;font-size:22px;line-height:1;padding:2px}
.user-area{display:flex;align-items:center;gap:8px;font-size:13px}
.user-area .sep{opacity:.4}
.book-btn{background:var(--red);color:#fff;padding:10px 20px;font-size:13px;letter-spacing:.1em;display:flex;align-items:center;gap:10px;transition:.3s;white-space:nowrap}
.book-btn:hover{background:var(--red-dark)}
.book-btn span{font-size:15px}
.menu-btn{display:none;border:none;background:none;flex-direction:column;gap:5px;padding:4px}
.menu-btn span{width:24px;height:1.5px;background:currentColor;display:block}

/* ---------- 首屏 ---------- */
.hero{position:relative;height:100vh;min-height:640px;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;overflow:hidden}
.hero-bg{position:absolute;inset:0;background-size:cover;background-position:center 55%;animation:slowzoom 20s ease-out forwards}
@keyframes slowzoom{from{transform:scale(1.06)}to{transform:scale(1)}}
.hero-mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,14,10,.5) 0%,rgba(20,14,10,.22) 40%,rgba(20,14,10,.55) 100%)}
.hero-content{position:relative;z-index:2;padding:0 20px;margin-top:-40px}
.hero-eyebrow{font-size:12px;letter-spacing:.5em;color:#f0d9c0;margin-bottom:28px;animation:fadeUp 1s .2s both}
.hero-title{font-family:var(--serif);font-size:clamp(40px,6vw,78px);font-weight:600;line-height:1.4;letter-spacing:.08em;text-shadow:0 2px 20px rgba(0,0,0,.2);animation:fadeUp 1s .35s both}
.hero-title span{color:#f3d9b8}
.hero-sub{font-family:Georgia,serif;font-style:italic;font-size:clamp(15px,1.6vw,20px);letter-spacing:.04em;color:rgba(255,255,255,.85);margin:24px 0 40px;animation:fadeUp 1s .5s both}
.hero-btns{display:flex;gap:22px;justify-content:center;align-items:center;animation:fadeUp 1s .65s both}
.hero .btn-outline{border-color:rgba(255,255,255,.85);color:#fff}
.hero .btn-outline:hover{background:#fff;color:var(--ink)}
@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
.scroll-down{position:absolute;bottom:120px;left:50%;transform:translateX(-50%);z-index:2;color:rgba(255,255,255,.8);font-size:9px;letter-spacing:.3em;display:flex;flex-direction:column;align-items:center;gap:12px}
.scroll-down i{width:1px;height:46px;background:linear-gradient(rgba(255,255,255,.8),transparent);position:relative;overflow:hidden}
.scroll-down i::after{content:"";position:absolute;top:-46px;left:0;width:1px;height:46px;background:#fff;animation:scrolldot 2s infinite}
@keyframes scrolldot{to{top:46px}}
.hero-side{position:absolute;left:32px;top:50%;transform:translateY(-50%) rotate(-90deg);transform-origin:left center;font-size:9px;letter-spacing:.35em;color:rgba(255,255,255,.6);z-index:2}

/* ---------- 预订搜索条 ---------- */
.booking-bar{position:relative;z-index:10;margin-top:-58px;width:min(1240px,90%);margin-left:auto;margin-right:auto;background:#fff;box-shadow:0 18px 50px rgba(0,0,0,.14)}
.bb-inner{display:grid;grid-template-columns:1fr 1fr 1.15fr .9fr auto;align-items:end;gap:0;padding:22px 26px}
.bb-field{padding:0 22px;border-right:1px solid var(--line)}
.bb-field:first-child{padding-left:6px}
.bb-field label{display:block;font-size:10px;letter-spacing:.14em;color:var(--muted);margin-bottom:9px}
.bb-field input,.bb-field select{width:100%;border:none;background:none;color:var(--ink);font-size:15px;font-family:var(--serif);outline:none;padding:0}
.bb-field select{cursor:pointer}
.bb-submit{margin-left:26px;background:var(--red);color:#fff;border:none;padding:16px 30px;font-size:14px;letter-spacing:.12em;display:flex;align-items:center;gap:14px;transition:.3s;height:100%;min-height:56px}
.bb-submit:hover{background:var(--red-dark)}

/* ---------- 关于 ---------- */
.about{background:var(--cream)}
.about-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:90px;align-items:center}
.about-img{position:relative;padding-right:34px;padding-bottom:34px}
.img-frame{overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.12)}
.img-frame img{height:560px;transition:transform 1s}
.about-img:hover img{transform:scale(1.04)}
.img-badge{position:absolute;right:0;bottom:0;background:var(--red);color:#fff;padding:26px 30px;text-align:center;min-width:150px}
.img-badge b{font-family:Georgia,serif;font-size:40px;line-height:1;display:block}
.img-badge b sup{font-size:18px}
.img-badge span{font-size:11px;letter-spacing:.14em;opacity:.9}
.about-txt .btn{margin-top:12px}
.about-stats{display:flex;gap:46px;margin:34px 0 30px;padding:26px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.about-stats div{display:flex;flex-direction:column}
.about-stats b{font-family:Georgia,serif;font-size:36px;color:var(--red);line-height:1}
.about-stats b em{font-style:normal;font-size:20px}
.about-stats span{font-size:12px;color:var(--muted);margin-top:8px;letter-spacing:.1em}

/* ---------- 客房 ---------- */
.rooms{background:#fff}
.sec-head{margin-bottom:50px}
.room-tabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:44px}
.room-tab{border:1px solid var(--line);background:#fff;color:var(--muted);padding:9px 22px;font-size:13px;letter-spacing:.1em;transition:.3s}
.room-tab:hover{border-color:var(--red);color:var(--red)}
.room-tab.active{background:var(--red);border-color:var(--red);color:#fff}
.room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.room-card{background:#fff;border:1px solid var(--line);transition:.35s;position:relative;overflow:hidden}
.room-card:hover{box-shadow:0 20px 50px rgba(0,0,0,.12);transform:translateY(-4px)}
.rc-img{position:relative;height:250px;overflow:hidden;background:#eee}
.rc-img img{height:100%;transition:transform .8s}
.room-card:hover .rc-img img{transform:scale(1.06)}
.rc-tag{position:absolute;top:14px;left:14px;background:rgba(255,255,255,.92);font-size:10px;letter-spacing:.1em;padding:5px 12px;color:var(--red)}
.rc-rest{position:absolute;top:14px;right:14px;background:rgba(26,23,21,.75);color:#fff;font-size:10px;padding:5px 12px;letter-spacing:.08em}
.rc-rest.none{background:rgba(120,120,120,.8)}
.rc-body{padding:24px 24px 26px}
.rc-name{font-family:var(--serif);font-size:21px;font-weight:600;letter-spacing:.06em;margin-bottom:6px}
.rc-en{font-family:Georgia,serif;font-style:italic;font-size:12px;color:var(--muted);margin-bottom:16px}
.rc-meta{display:flex;flex-wrap:wrap;gap:8px 16px;font-size:12px;color:#6f6860;padding-bottom:18px;border-bottom:1px solid var(--line)}
.rc-meta span{display:flex;align-items:center;gap:5px}
.rc-meta i{font-style:normal;color:var(--red)}
.rc-bottom{display:flex;align-items:flex-end;justify-content:space-between;margin-top:16px}
.rc-price b{font-family:Georgia,serif;font-size:27px;color:var(--red)}
.rc-price b small{font-size:14px}
.rc-price span{font-size:11px;color:var(--muted);margin-left:4px}
.rc-book{border:1px solid var(--ink);background:none;color:var(--ink);padding:9px 18px;font-size:12px;letter-spacing:.1em;transition:.3s}
.rc-book:hover{background:var(--red);border-color:var(--red);color:#fff}
.rc-book:disabled{opacity:.4;cursor:not-allowed}
.rooms-foot{text-align:center;margin-top:50px;color:var(--muted);font-size:13px}
.rooms-foot p{margin-bottom:22px;letter-spacing:.06em}

/* ---------- 餐饮 ---------- */
.dining{background:var(--cream);padding:0}
.dining-row{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:0}
.dining-row.reverse .dining-img{order:2}
.dining-img{height:560px;overflow:hidden}
.dining-img img{height:100%;transition:transform 1s}
.dining-img:hover img{transform:scale(1.05)}
.dining-txt{padding:60px clamp(40px,7vw,110px)}
.dining-txt .para{max-width:460px}
.dining-meta{display:flex;gap:24px;margin-top:28px;padding-top:22px;border-top:1px solid var(--line);font-size:12px;color:var(--muted);letter-spacing:.08em}
.dining-meta span:first-child{color:var(--red)}

/* ---------- 设施 ---------- */
.facility{background:var(--ink);color:#fff}
.facility .sec-title{color:#fff}
.facility .sec-en{color:#9b9389}
.facility .sec-eyebrow{color:#e0b98a}
.facility .sec-eyebrow .line{background:#e0b98a}
.facility-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.fac-card{position:relative;height:400px;overflow:hidden;display:block}
.fac-card img{height:100%;transition:transform .8s,filter .5s;filter:brightness(.78)}
.fac-card:hover img{transform:scale(1.07);filter:brightness(.95)}
.fc-mask{position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(0,0,0,.75))}
.fc-txt{position:absolute;left:0;bottom:0;padding:26px 22px;transition:.3s}
.fc-txt b{font-family:var(--serif);font-size:19px;display:block;letter-spacing:.08em}
.fc-txt span{font-family:Georgia,serif;font-size:10px;letter-spacing:.2em;color:#d9b98e}
.service-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:60px;padding-top:44px;border-top:1px solid rgba(255,255,255,.14)}
.service-strip>div{text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px}
.serv-ic{font-size:26px;color:#d9b98e;margin-bottom:4px}
.service-strip b{font-family:var(--serif);font-size:15px;letter-spacing:.12em}
.service-strip i{font-family:Georgia,serif;font-size:11px;color:#8f8880;font-style:italic}

/* ---------- 新闻 ---------- */
.news{background:#fff}
.news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px}
.news-card{display:block;transition:.3s}
.news-card:hover{transform:translateY(-5px)}
.nc-img{height:240px;overflow:hidden}
.nc-img img{height:100%;transition:transform .7s}
.news-card:hover .nc-img img{transform:scale(1.06)}
.nc-body{padding:22px 2px}
.nc-date{font-family:Georgia,serif;font-size:11px;color:var(--red);letter-spacing:.16em}
.nc-body h3{font-family:var(--serif);font-size:19px;font-weight:600;line-height:1.5;margin:12px 0 10px;letter-spacing:.04em}
.nc-body p{font-size:13px;color:var(--muted);line-height:1.8;margin-bottom:14px}
.nc-more{font-size:12px;color:var(--red);letter-spacing:.08em}

/* ---------- 预订横幅 ---------- */
.cta-band{position:relative;height:420px;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;overflow:hidden}
.cta-bg{position:absolute;inset:0;background-size:cover;background-position:center 50%;background-attachment:fixed}
.cta-mask{position:absolute;inset:0;background:rgba(20,14,10,.58)}
.cta-inner{position:relative;z-index:2}
.cta-inner .sec-eyebrow{color:#e9c9a3}
.cta-inner h2{font-family:var(--serif);font-size:clamp(28px,3.6vw,44px);font-weight:600;letter-spacing:.1em;margin:18px 0 8px}
.cta-en{font-family:Georgia,serif;font-style:italic;font-size:16px;color:rgba(255,255,255,.75);margin-bottom:30px}

/* ---------- 页脚 ---------- */
.site-footer{background:var(--wood);color:#c9c2b8;padding:80px 0 0;font-size:13px}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.5fr;gap:50px;padding-bottom:60px}
.foot-brand .brand-mark{color:var(--red)}
.foot-brand .brand{margin-bottom:22px}
.foot-brand p{font-family:var(--serif);font-size:16px;line-height:1.9;color:#e6ded2;letter-spacing:.06em}
.foot-social{display:flex;gap:10px;margin-top:24px}
.foot-social a{width:32px;height:32px;border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:12px;transition:.3s}
.foot-social a:hover{background:var(--red);border-color:var(--red);color:#fff}
.foot-col h4{color:#fff;font-family:var(--serif);font-size:15px;letter-spacing:.16em;margin-bottom:22px;font-weight:600}
.foot-col>a{display:block;padding:5px 0;color:#a89f94;transition:.2s}
.foot-col>a:hover{color:#fff;padding-left:6px}
.foot-contact p{display:flex;gap:12px;margin-bottom:12px;line-height:1.6}
.foot-contact span{color:#8b8277;flex-shrink:0}
.foot-contact b{color:#d8d0c4;font-weight:400}
.foot-bottom{border-top:1px solid rgba(255,255,255,.1);padding:22px 0;display:flex;justify-content:space-between;font-size:11px;color:#837a70;letter-spacing:.04em;width:min(1240px,90%);margin:0 auto}

/* ---------- 悬浮工具 ---------- */
.float-tools{position:fixed;right:22px;bottom:32px;z-index:90;display:flex;flex-direction:column;gap:10px}
.float-btn{width:52px;border:none;background:rgba(164,20,60,.92);color:#fff;padding:10px 0;display:flex;flex-direction:column;align-items:center;gap:3px;transition:.3s;box-shadow:0 6px 18px rgba(0,0,0,.16)}
.float-btn:hover{background:var(--red-dark);transform:translateX(-3px)}
.float-btn.top{background:rgba(26,23,21,.85)}
.f-ic{font-size:17px;line-height:1}
.f-tx{font-size:9px;line-height:1.3;letter-spacing:.05em;text-align:center}

/* ---------- 模态框 ---------- */
.modal{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;padding:20px}
.modal.open{display:flex}
.modal-mask{position:absolute;inset:0;background:rgba(15,11,8,.68);backdrop-filter:blur(4px)}
.modal-box{position:relative;z-index:2;width:min(440px,100%);max-height:92vh;overflow-y:auto;background:#fff;padding:44px 42px 34px;box-shadow:0 24px 70px rgba(0,0,0,.3);animation:modalIn .35s both}
.modal-box.wide{width:min(660px,100%)}
@keyframes modalIn{from{opacity:0;transform:translateY(24px) scale(.98)}to{opacity:1;transform:none}}
.modal-close{position:absolute;top:14px;right:18px;border:none;background:none;font-size:26px;color:#999;line-height:1}
.modal-close:hover{color:var(--red)}
.modal-head{text-align:center;margin-bottom:28px}
.modal-head p{font-family:Georgia,serif;font-size:11px;letter-spacing:.28em;color:var(--red)}
.modal-head h3{font-family:var(--serif);font-size:26px;font-weight:600;letter-spacing:.1em;margin:8px 0}
.modal-head span{font-size:12px;color:var(--muted)}
.modal-form label{display:block;font-size:12px;color:#5f5a53;margin:16px 0 7px;letter-spacing:.06em}
.modal-form input,.modal-form select{width:100%;padding:11px 13px;border:1px solid #dcd7ce;background:#fdfcfa;font-size:14px;outline:none;transition:.2s}
.modal-form input:focus,.modal-form select:focus{border-color:var(--red);background:#fff}
.form-msg{font-size:12px;min-height:18px;margin:10px 0;color:var(--red)}
.form-msg.ok{color:#1a8a4a}
.modal-foot{text-align:center;margin-top:22px;font-size:12px;color:var(--muted)}
.grid-form{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}
.grid-form .full{grid-column:1/-1}
.price-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--cream);padding:14px 18px;margin-top:18px}
.price-row span{font-size:12px;color:var(--muted)}
.price-row b{font-family:Georgia,serif;font-size:24px;color:var(--red)}
.price-row small{font-size:11px;color:var(--muted);width:100%}

/* 订单列表 */
.orders-list{display:flex;flex-direction:column;gap:14px;max-height:60vh;overflow-y:auto}
.order-item{border:1px solid var(--line);padding:18px 20px;position:relative}
.oi-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.oi-no{font-size:11px;color:var(--muted)}
.oi-status{font-size:11px;padding:3px 10px;background:#f0f0f0;color:#666}
.oi-status.st0{background:#fff3d6;color:#a56a00}
.oi-status.st1{background:#e3f2e8;color:#1a8a4a}
.oi-status.st2{background:#e5eefb;color:#2c62b0}
.oi-status.st-1,.oi-status.st-2,.oi-status.st-3{background:#f5e5e5;color:#a33}
.oi-main{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;font-size:13px}
.oi-main b{display:block;font-family:var(--serif);font-size:15px;margin-top:2px}
.oi-main small{color:var(--muted);font-size:11px}
.oi-foot{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:12px;border-top:1px dashed var(--line)}
.oi-cost{font-family:Georgia,serif;font-size:20px;color:var(--red)}
.oi-acts{display:flex;gap:8px}
.oi-acts button{border:1px solid var(--ink);background:none;padding:6px 14px;font-size:12px;transition:.2s}
.oi-acts button:hover{background:var(--ink);color:#fff}
.oi-acts button.danger:hover{background:var(--red);border-color:var(--red)}
.profile-body{padding:10px 0 22px;font-size:14px}
.profile-body p{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)}
.profile-body span{color:var(--muted)}

/* 提示 */
.toast{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(.9);background:rgba(26,23,21,.94);color:#fff;padding:14px 28px;font-size:14px;letter-spacing:.06em;z-index:300;opacity:0;pointer-events:none;transition:.3s;box-shadow:0 10px 40px rgba(0,0,0,.3)}
.toast.show{opacity:1;transform:translate(-50%,-50%) scale(1)}

/* 滚动入场 —— 默认可见，只有 JS 成功运行(html.js-ready)时才启用隐藏动画。
   这样即使脚本出错/被拦截，图片也绝不会因动画失效而消失。 */
.reveal{opacity:1;transform:none;transition:opacity .8s,transform .8s}
.js-ready .reveal{opacity:0;transform:translateY(30px)}
.js-ready .reveal.in{opacity:1;transform:none}

/* ---------- 响应式 ---------- */
@media(max-width:1100px){
  .main-nav{gap:18px}
  .main-nav a{font-size:12px}
  .hd-actions{gap:10px}
  .bb-inner{grid-template-columns:1fr 1fr;gap:18px}
  .bb-field{border:none;padding:0}
  .bb-submit{margin:0;grid-column:1/-1;justify-content:center}
  .room-grid{grid-template-columns:repeat(2,1fr)}
  .facility-grid{grid-template-columns:repeat(2,1fr)}
  .foot-grid{grid-template-columns:1fr 1fr;gap:36px}
}
@media(max-width:820px){
  .section{padding:80px 0}
  .menu-btn{display:flex}
  .main-nav{position:absolute;top:100%;left:0;width:100%;background:rgba(26,23,21,.98);flex-direction:column;gap:0;padding:10px 0;display:none;color:#fff}
  .main-nav.open{display:flex}
  .main-nav a{padding:13px 24px;font-size:14px}
  .icon-btn,.user-area{display:none}
  .book-btn{padding:8px 14px;font-size:12px}
  .brand-text{display:none}
  .about-grid{grid-template-columns:1fr;gap:44px}
  .about-img{padding-right:20px;padding-bottom:20px}
  .img-frame img{height:420px}
  .dining-row,.dining-row.reverse{grid-template-columns:1fr}
  .dining-row.reverse .dining-img{order:0}
  .dining-img{height:340px}
  .dining-txt{padding:46px 6%}
  .news-grid{grid-template-columns:1fr}
  .hero-side{display:none}
  .scroll-down{bottom:100px}
  .service-strip{grid-template-columns:repeat(2,1fr)}
  .cta-bg{background-attachment:scroll}
}
@media(max-width:560px){
  .room-grid{grid-template-columns:1fr}
  .facility-grid{grid-template-columns:1fr 1fr;gap:10px}
  .fac-card{height:260px}
  .foot-grid{grid-template-columns:1fr}
  .foot-bottom{flex-direction:column;gap:8px;text-align:center}
  .about-stats{gap:24px}
  .grid-form{grid-template-columns:1fr}
  .modal-box{padding:38px 24px 28px}
  .bb-inner{padding:18px}
  .hero-title{font-size:34px}
  .float-tools{right:12px;bottom:18px}
}

/* 房型卡片详情/预订双按钮 */
.rc-btns{display:flex;gap:8px;align-items:center}
.rc-detail{border:1px solid var(--line);background:none;color:var(--muted);padding:9px 16px;font-size:13px;cursor:pointer;transition:.2s;white-space:nowrap}
.rc-detail:hover{border-color:var(--ink);color:var(--ink)}
/* 个人中心操作区与编辑表单 */
.profile-actions{display:flex;gap:10px;margin-top:18px}
.profile-actions .btn{flex:1;padding:10px;font-size:13px;cursor:pointer}
.edit-form{margin-top:18px;padding-top:18px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:8px}
.edit-form label{font-size:12px;color:var(--muted);margin-top:6px}
.edit-form input,.edit-form select{width:100%;height:38px;padding:0 10px;border:1px solid var(--line);background:var(--bg);outline:none;font-size:13px}
.edit-form input:focus,.edit-form select:focus{border-color:var(--ink)}
.edit-form input[readonly]{background:#eceae5;color:var(--muted)}

/* 员工登录入口 */
.staff-entry{border:1px solid rgba(255,255,255,.45);padding:5px 11px;font-size:12px;letter-spacing:.05em;transition:.25s}
.staff-entry:hover{border-color:var(--red);color:#fff;background:var(--red)}
header:not(.scrolled) .staff-entry{border-color:rgba(255,255,255,.6)}
.sep-staff{margin:0 2px;opacity:.35}
.nav-staff{display:none}
@media(max-width:820px){
  .nav-staff{display:block!important;color:#e8c9c9!important;border-top:1px solid rgba(255,255,255,.12);margin-top:6px}
}
